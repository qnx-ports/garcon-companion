# Maintainer: Natanael Copa <ncopa@alpinelinux.org>
# QNX Maintainer: Felix Xing <fxing@qnx.com>
pkgname=garcon
pkgver=4.21.0
pkgrel=2
pkgdesc="a freedesktop.org compliant menu implementation based on GLib and GIO"
url="https://xfce.org/"
arch="all"
license="GPL-2.0-or-later"
subpackages="$pkgname-dev $pkgname-lang"
depends="gtk3 libintl libxfce4ui libxfce4util"
makedepends="
    glib-dev
    gobject-introspection-dev
    gtk3-dev
    gettext-dev
    libxfce4ui-dev
    libxfce4util-dev
    xfce4-dev-tools
    "
source="https://archive.xfce.org/src/xfce/garcon/${pkgver%.*}/garcon-$pkgver.tar.xz
"
replaces="xfdesktop"

build() {
    meson setup build \
        --prefix=/usr \
        -Db_lto=false \
        -Dtests=false \
        -Dlibexecdir=/usr/lib
    meson compile -C build
}

check() {
    meson test --print-errorlogs -C build
}

package() {
    DESTDIR="$pkgdir" meson install --no-rebuild -C build
}


sha512sums="
